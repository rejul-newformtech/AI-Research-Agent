# ==========================================
# Research Agent Environment Configuration
# ==========================================

# Google Gemini API Key (Required for vector embeddings & generation)
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Application Configuration
APP_NAME="Research Agent API"
APP_VERSION="0.1.0"
DEBUG=false
LOG_LEVEL=INFO

# Embedding & Chunking Configuration
EMBEDDING_MODEL=gemini-embedding-001
DEFAULT_CHUNK_SIZE=1000
DEFAULT_CHUNK_OVERLAP=200
DEFAULT_BREAKPOINT_PERCENTILE=85.0

# Storage Paths
PDF_STORAGE_DIR=data/pdfs
CHROMA_PERSIST_DIR=data/chroma
CHROMA_COLLECTION_NAME=research_documents
LOG_DIR=logs
