# ==========================================
# Research Agent Environment Configuration
# ==========================================

# Google Gemini API Key (Required for vector embeddings & generation)
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Application Configuration
APP_NAME="Research Agent API"
APP_VERSION="0.1.0"
DEBUG=false
LOG_LEVEL=INFO

# Embedding & Chunking Configuration
EMBEDDING_MODEL=gemini-embedding-001
DEFAULT_CHUNK_SIZE=1000
DEFAULT_CHUNK_OVERLAP=200
DEFAULT_BREAKPOINT_PERCENTILE=85.0

# Storage Paths
DOCUMENT_STORAGE_DIR=data/documents
PDF_STORAGE_DIR=data/documents
CHROMA_PERSIST_DIR=data/chroma
CHROMA_COLLECTION_NAME=research_documents
LOG_DIR=logs

# ==========================================
# Database Configuration (Hot-Swappable)
# ==========================================
# Choose Database Dialect: "sqlite", "postgres", or "mysql"
DB_TYPE=sqlite

# Individual Database Credentials (used when DB_TYPE=postgres or mysql)
DB_USER=postgres
DB_PASSWORD=your_secure_password_here
DB_HOST=localhost
DB_PORT=5432
DB_NAME=research_agent

# Or explicit connection string (overrides individual credentials if provided)
DATABASE_URL=sqlite:///data/research_agent.db
# DATABASE_URL=postgresql+psycopg2://postgres:your_secure_password_here@localhost:5432/research_agent

# Connection Pool Settings (automatically applied to PostgreSQL / MySQL)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Authentication Configuration
JWT_SECRET_KEY=change-this-to-a-secure-random-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
